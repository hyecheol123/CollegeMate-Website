{
  "name": "collegemate-webpage",
  "version": "1.0.0",
  "description": "Web Front-End for CollegeMate project",
  "author": "Hyecheol (Jerry) Jang <hyecheol123@gmail.com>",
  "main": "src/App.tsx",
  "license": "ISC",
  "browserslist": [
    "defaults",
    "> 0.25% in KR",
    "> 0.25% in US"
  ],
  "scripts": {
    "dev": "webpack serve --mode development --open --hot --config ./webpack.dev.js --progress",
    "build": "cross-env NODE_ENV=production webpack --config ./webpack.prod.js --progress",
    "lint": "prettier --check \"**/*.{js,jsx,css,ts,tsx}\" && eslint \"**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "prettier --write \"**/*.{js,jsx,css,ts,tsx}\" && eslint --fix \"**/*.{js,jsx,ts,tsx}\""
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css}": [
      "npm run lint:fix",
      "git add"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyecheol123/CollegeMate-Webpage.git"
  },
  "bugs": {
    "url": "https://github.com/hyecheol123/CollegeMate-Webpage/issues"
  },
  "homepage": "https://github.com/hyecheol123/CollegeMae-Webpage#readme",
  "dependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/material": "^5.14.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.22.15",
    "@babel/preset-env": "^7.22.20",
    "@babel/preset-react": "^7.22.15",
    "@babel/preset-typescript": "^7.23.0",
    "@babel/runtime": "^7.23.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.11",
    "@types/react": "^18.2.24",
    "@types/react-dom": "^18.2.8",
    "babel-loader": "^9.1.3",
    "core-js": "^3.33.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.8.1",
    "eslint": "^8.50.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-jsdoc": "^46.8.2",
    "eslint-plugin-prettier": "^5.0.0",
    "html-webpack-plugin": "^5.5.3",
    "prettier": "^3.0.3",
    "react-refresh": "^0.14.0",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.4.4",
    "typescript": "^5.2.2",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "webpack-merge": "^5.9.0"
  }
}