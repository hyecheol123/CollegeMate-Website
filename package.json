{
  "name": "collegemate-webpage",
  "version": "1.0.0",
  "description": "Web Front-End for CollegeMate project",
  "author": "Hyecheol (Jerry) Jang <hyecheol123@gmail.com>",
  "main": "src/App.tsx",
  "license": "ISC",
  "browserslist": [
    "defaults",
    "> 0.25% in KR",
    "> 0.25% in US"
  ],
  "scripts": {
    "dev": "cross-env NODE_ENV=development webpack serve --mode development --open --hot --config ./webpack.dev.cjs --progress",
    "api": "node server.js",
    "dev:full": "concurrently \"npm run api\" \"npm run dev\"",
    "build": "cross-env NODE_ENV=production webpack --config ./webpack.prod.cjs --progress",
    "serve": "cross-env NODE_ENV=production webpack serve --open --config ./webpack.serve.cjs --progress",
    "lint": "prettier --check \"**/*.{js,jsx,css,ts,tsx}\" && eslint \"**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "prettier --write \"**/*.{js,jsx,css,ts,tsx}\" && eslint --fix \"**/*.{js,jsx,ts,tsx}\""
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css}": [
      "npm run lint:fix",
      "git add"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyecheol123/CollegeMate-Webpage.git"
  },
  "bugs": {
    "url": "https://github.com/hyecheol123/CollegeMate-Webpage/issues"
  },
  "homepage": "https://github.com/hyecheol123/CollegeMae-Webpage#readme",
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@fontsource/roboto": "^5.1.0",
    "@mui/icons-material": "^6.1.0",
    "@mui/material": "^6.1.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.25.4",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-react": "^7.24.7",
    "@babel/preset-typescript": "^7.24.7",
    "@babel/runtime": "^7.25.6",
    "@babel/runtime-corejs3": "^7.25.6",
    "@eslint/compat": "^1.1.1",
    "@eslint/js": "^9.10.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.15",
    "@types/eslint__js": "^8.42.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "babel-loader": "^9.1.3",
    "concurrently": "^9.2.0",
    "core-js": "^3.38.1",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsdoc": "^50.2.3",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.36.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "express": "^5.1.0",
    "globals": "^15.9.0",
    "html-webpack-plugin": "^5.6.0",
    "image-minimizer-webpack-plugin": "^4.1.0",
    "node-fetch": "^3.3.2",
    "prettier": "^3.3.3",
    "react-refresh": "^0.14.2",
    "sharp": "^0.33.5",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.5.0",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0",
    "webpack-merge": "^6.0.1"
  },
  "overrides": {
    "typescript-eslint": {
      "eslint": "^9.10.0"
    },
    "eslint-plugin-react-hooks": {
      "eslint": "^9.10.0"
    }
  }
}
