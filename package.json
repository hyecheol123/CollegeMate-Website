{
  "name": "collegemate-webpage",
  "version": "1.0.0",
  "description": "Web Front-End for CollegeMate project",
  "author": "Hyecheol (Jerry) Jang <hyecheol123@gmail.com>",
  "main": "src/App.tsx",
  "license": "ISC",
  "browserslist": [
    "defaults",
    "> 0.25% in KR",
    "> 0.25% in US"
  ],
  "scripts": {
    "dev": "cross-env NODE_ENV=development webpack serve --mode development --open --hot --config ./webpack.dev.cjs --progress",
    "build": "cross-env NODE_ENV=production webpack --config ./webpack.prod.cjs --progress",
    "serve": "cross-env NODE_ENV=production webpack serve --open --config ./webpack.serve.cjs --progress",
    "lint": "prettier --check \"**/*.{js,jsx,css,ts,tsx}\" && eslint \"**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "prettier --write \"**/*.{js,jsx,css,ts,tsx}\" && eslint --fix \"**/*.{js,jsx,ts,tsx}\""
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css}": [
      "npm run lint:fix",
      "git add"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyecheol123/CollegeMate-Webpage.git"
  },
  "bugs": {
    "url": "https://github.com/hyecheol123/CollegeMate-Webpage/issues"
  },
  "homepage": "https://github.com/hyecheol123/CollegeMae-Webpage#readme",
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@fontsource/roboto": "^5.0.8",
    "@mui/icons-material": "^5.14.18",
    "@mui/material": "^5.14.18",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.3",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.23.4",
    "@babel/preset-env": "^7.23.3",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@babel/runtime": "^7.23.4",
    "@babel/runtime-corejs3": "^7.23.4",
    "@eslint/compat": "^1.1.1",
    "@eslint/js": "^9.7.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.15",
    "@types/eslint__js": "^8.42.3",
    "@types/react": "^18.2.38",
    "@types/react-dom": "^18.2.17",
    "babel-loader": "^9.1.3",
    "core-js": "^3.33.3",
    "cross-env": "^7.0.3",
    "css-loader": "^6.8.1",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsdoc": "^48.8.3",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "globals": "^15.8.0",
    "html-webpack-plugin": "^5.5.3",
    "image-minimizer-webpack-plugin": "^3.8.3",
    "install": "^0.13.0",
    "npm": "^10.2.4",
    "prettier": "^3.3.3",
    "react-refresh": "^0.14.0",
    "sharp": "^0.32.6",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^7.16.1",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "webpack-merge": "^5.10.0"
  },
  "overrides": {
